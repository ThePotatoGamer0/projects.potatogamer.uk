{
  "redirects": [
    {
      "source": "/time",
      "destination": "https://time.potatogamer.uk/",
      "permanent": true
    },
    {
      "source": "/time/:path*",
      "destination": "https://time.potatogamer.uk/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
