{
  "redirects": [
    {
      "source": "/time",
      "destination": "https://time.potatogamer.uk/",
      "permanent": true
    },
    {
      "source": "/time/:path*",
      "destination": "https://time.potatogamer.uk/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "time.potatogamer.uk"
        }
      ],
      "destination": "/time/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
