{
  "routes": [
    {
      "src": "^/time(?:/(.*))?$",
      "status": 308,
      "headers": {
        "Location": "https://time.potatogamer.uk/$1"
      }
    },
    {
      "src": "^/(.*)$",
      "has": [
        {
          "type": "host",
          "value": "time.potatogamer.uk"
        }
      ],
      "dest": "/time/$1",
      "continue": true
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "^/(.*)$",
      "has": [
        {
          "type": "host",
          "value": "time.potatogamer.uk"
        }
      ],
      "dest": "/time/index.html"
    },
    {
      "src": "^/(.*)$",
      "dest": "/index.html"
    }
  ]
}
